# ========================================================
# TechSphere Frontend - Production .gitignore
# ========================================================

# --- Dependencies ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js Build Outputs & Static Exports ---
.next/
out/
build/
dist/

# --- Environment Variables & Sensitive Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json

# --- Debug & Process Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- Vercel / Netlify Previews & Caches ---
.vercel
.netlify

# --- TypeScript Build Cache ---
*.tsbuildinfo
next-env.d.ts

# --- Testing & Code Coverage ---
coverage/
.nyc_output/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE & Editor Configurations ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
